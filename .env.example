# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local

# Anthropic API key — the agent runs on Claude (Phase 1+).
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Slack human-in-the-loop. Create an app at https://api.slack.com/apps
# Bot User OAuth Token (OAuth & Permissions). Scope: chat:write.
# Enable Interactivity and point the Request URL at <APP_BASE_URL>/api/slack/interactions.
SLACK_BOT_TOKEN=xoxb-...
# Signing Secret (Basic Information → App Credentials) — verifies inbound requests.
SLACK_SIGNING_SECRET=...
# The channel the agent posts approval requests to (e.g. C0123ABCDE).
SLACK_APPROVAL_CHANNEL_ID=C0123ABCDE

# Base URL of this app — used to build the "View case details" link in Slack.
# Defaults to http://localhost:3001; set to your deployed URL in production.
APP_BASE_URL=http://localhost:3001
