# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local

# Anthropic API key — the agent runs on Claude (Phase 1+).
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Slack human-in-the-loop (Phase 3). Create an app at https://api.slack.com/apps
# Bot User OAuth Token (OAuth & Permissions). Scopes: chat:write, commands.
SLACK_BOT_TOKEN=xoxb-...
# Signing Secret (Basic Information → App Credentials) — verifies inbound requests.
SLACK_SIGNING_SECRET=...
# The channel the agent posts approval requests to (e.g. C0123ABCDE).
SLACK_APPROVAL_CHANNEL_ID=C0123ABCDE
